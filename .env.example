# Copie para .env e preencha com o workspace do desafio FEA
# dbt Fusion / extensão VS Code carregam automaticamente variáveis com prefixo DBT_

DBT_DATABRICKS_HOST=dbc-xxxxx.cloud.databricks.com
DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxx
DBT_DATABRICKS_TOKEN=seu_personal_access_token
DBT_DATABRICKS_CATALOG=adventureworks
DBT_DATABRICKS_SCHEMA=raw

# Aliases para o script de EL (scripts/load_raw_to_databricks.py)
DATABRICKS_HOST=dbc-xxxxx.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxx
DATABRICKS_TOKEN=seu_personal_access_token
DATABRICKS_CATALOG=adventureworks
DATABRICKS_SCHEMA=raw
DATABRICKS_RAW_SCHEMA=raw

# PostgreSQL AdventureWorks
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=adventureworks
POSTGRES_USER=adventureworks
POSTGRES_PASSWORD=adventureworks
